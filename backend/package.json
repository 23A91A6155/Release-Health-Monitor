{
  "name": "release-health-monitor-backend",
  "version": "1.0.0",
  "description": "Release Health Monitor Backend - Express API with Sentry Integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "release": "npm run build && sentry-cli releases new $SENTRY_RELEASE && sentry-cli releases files $SENTRY_RELEASE upload-sourcemaps ./dist --url-prefix '~/dist' && sentry-cli releases finalize $SENTRY_RELEASE",
    "release:v1.0.0": "cross-env SENTRY_RELEASE=release-health-monitor@1.0.0 npm run release",
    "release:v1.1.0": "cross-env SENTRY_RELEASE=release-health-monitor@1.1.0 npm run release",
    "release:v1.1.1": "cross-env SENTRY_RELEASE=release-health-monitor@1.1.1 npm run release"
  },
  "dependencies": {
    "@sentry/node": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@sentry/cli": "^2.33.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
